# Public site URL (used for canonicals, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://billionconversion.com

# Set to "false" on staging/preview deployments to block all crawlers
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Tag Manager container (GA4 is configured inside GTM). Leave empty to disable analytics + cookie banner.
NEXT_PUBLIC_GTM_ID=

# Google Search Console HTML-tag verification code (content value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Lead delivery (server-only; any combination) ---
# POST each lead as JSON to a webhook (Zapier / Make / n8n / Google Apps Script / CRM)
LEAD_WEBHOOK_URL=
# Email notification via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
